# Build specification and private notes
DEVIATIONS.md

# Generation archives and model registry
runs/
mlruns/

# Data (samples and the gold snapshot are tracked; local_gold, the parity output, is not)
data/*
!data/samples/
!data/gold_snapshot/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Local Spark state
spark-warehouse/
metastore_db/
derby.log

# Databricks and Azure local state and credentials
.databrickscfg
.env
*.azcred
.databricks/

# Bundle build output
dist/
build/

# Local MLflow tracking store
mlflow.db

# Connectivity chain: run outputs and reports, landed Parquet, native device files, Ignition gateway
# data volume, the vendor module and machine-specific config. The 1 Hz window is under data/ above.
connectivity/runs/
connectivity/landing/
connectivity/native/
connectivity/**/*.parquet
connectivity/ignition/data/
*.modl
connectivity/config/chain.local.yaml
